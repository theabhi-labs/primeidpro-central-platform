# PRIME ID PRO — STAGING ENVIRONMENT CONFIGURATION
# Staging isolation environment: Use Razorpay TEST mode and isolated MongoDB Atlas / Cloudflare R2 bucket.

NODE_ENV=staging
PORT=5000
CLIENT_URL=https://staging.primeidpro.online
DOMAIN=https://api-staging.primeidpro.online

# MongoDB Atlas Database (Staging Database Name: primeidpro_staging)
MONGODB_URI=mongodb+srv://<staging_username>:<staging_password>@cluster.mongodb.net/primeidpro_staging?retryWrites=true&w=majority
USE_MEMORY_DB_FALLBACK=false

# Authentication Secrets (Separate from Production)
JWT_SECRET=your_super_strong_staging_jwt_secret_key_minimum_64_chars
DEVICE_JWT_SECRET=your_super_strong_staging_device_binding_secret_64_chars
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (TEST Mode Credentials ONLY in Staging)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_staging_webhook_secret_key
PAYMENT_TEST_MODE=true

# Photo Storage — Cloudflare R2 Staging Private Bucket
STORAGE_DRIVER=R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=primeidpro-staging-temp-photos
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_REGION=auto

# Storage Retention & Privacy TTL
PHOTO_RETENTION_MINUTES=10
UPLOAD_RETENTION_HOURS=2
SIGNED_URL_EXPIRES_SECONDS=900
CLEANUP_INTERVAL_MS=60000
