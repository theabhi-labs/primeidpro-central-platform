# PRIME ID PRO — SERVER ENVIRONMENT CONFIGURATION

PORT=5000
NODE_ENV=production
CLIENT_URL=https://primeidpro.online
DOMAIN=https://primeidpro.online

# MongoDB Database (Production ReplicaSet / Mongo Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/primeidpro?retryWrites=true&w=majority
USE_MEMORY_DB_FALLBACK=false

# Authentication & Security
JWT_SECRET=your_super_strong_production_jwt_secret_key_minimum_64_chars
JWT_EXPIRES_IN=7d
DEVICE_JWT_SECRET=your_super_strong_device_binding_secret_key_64_chars

# Razorpay Payment Gateway (Live credentials in Production)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key
PAYMENT_TEST_MODE=false

# Photo Storage — Cloudflare R2 Private Object Storage (Production)
STORAGE_DRIVER=R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=primeidpro-private-temp-photos
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_REGION=auto

# Storage Retention & Privacy TTL
PHOTO_RETENTION_MINUTES=10
UPLOAD_RETENTION_HOURS=2
SIGNED_URL_EXPIRES_SECONDS=900
CLEANUP_INTERVAL_MS=60000
